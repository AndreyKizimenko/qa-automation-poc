# OS / editor junk
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
*.swp
*.swo

# Claude Code local settings
.claude/settings.local.json
# Repo-root harness state (scheduled-task locks, etc.). Keep
# playwright/.claude/ checked in — that's the shared skills tree.
/.claude/

# Logs
*.log

# Playwright MCP browser-tooling artifacts: page snapshots and console
# logs captured during interactive exploration. May contain DOM dumps
# of the live QA instance (host names, emails, etc.) — never commit.
.playwright-mcp/

# Playwright-suite ignores live in playwright/.gitignore

# Output of gitops/loadtest/generate.sh — bulk yml/scripts/profiles/etc.
# regenerated locally before each loadtest run. Only the generator script
# is checked in.
gitops/loadtest/generated/

# Source QA Wolf *.flow.js exports (flows-Free/, flows-Premium/). Kept for
# reference during the migration; not runnable and not part of the suite.
qa-wolf/

# QA ops tooling (tools/) is checked in. What must never be:
#
# Real instance URLs + enroll secrets. The committed launchd plists are
# templates with __PLACEHOLDER__ tokens; install.sh substitutes from this file.
tools/perf-hosts/perf-hosts.env

# Output of tools/windows-mdm-loadtest/generate.sh. The generator is
# deterministic, so these regenerate byte-identical — only it is checked in.
tools/windows-mdm-loadtest/profiles_*/
tools/windows-mdm-loadtest/batch_*.json
# Host-ID cache written by transfer_hosts.sh.
tools/windows-mdm-loadtest/ids_*.txt
