# The throwaway instance (`QA — Throwaway instance`): a free Fleet the workflow brings up on its runner.
# CI passes every value in the environment; a local run against your own throwaway (see
# .github/throwaway-instance/README.md) copies this to .env.throwaway.
FLEET_URL=http://localhost:8080
# The admin the run made: through Fleet's first-run setup page, or `fleet-data.mjs setup`.
FLEET_ADMIN_EMAIL=
FLEET_ADMIN_PASSWORD=
# That admin's session token (`fleet-data.mjs login`), for the API helpers.
FLEET_API_TOKEN=
# How many osquery-perf hosts the run enrolled: the specs expect exactly these.
THROWAWAY_HOSTS=
