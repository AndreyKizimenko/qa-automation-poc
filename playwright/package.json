{
  "name": "playwright",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test:premium": "SUITE=premium playwright test --project=premium; s=$?; SUITE=premium PLAYWRIGHT_HTML_OUTPUT_DIR=playwright-report-exclusive playwright test --project=premium-exclusive; e=$?; SUITE=premium PLAYWRIGHT_HTML_OUTPUT_DIR=playwright-report-gitops-mode playwright test --project=gitops-mode; g=$?; exit $((s || e || g))",
    "test:premium:headed": "SUITE=premium playwright test --project=premium --headed; s=$?; SUITE=premium PLAYWRIGHT_HTML_OUTPUT_DIR=playwright-report-exclusive playwright test --project=premium-exclusive --headed; e=$?; SUITE=premium PLAYWRIGHT_HTML_OUTPUT_DIR=playwright-report-gitops-mode playwright test --project=gitops-mode --headed; g=$?; exit $((s || e || g))",
    "test:premium:ui": "SUITE=premium playwright test --project=premium --ui",
    "test:premium:exclusive": "SUITE=premium playwright test --project=premium-exclusive",
    "test:gitops-mode": "SUITE=premium playwright test --project=gitops-mode",
    "test:gitops-mode:only": "SUITE=premium playwright test --project=gitops-mode --no-deps",
    "test:gitops-mode:headed": "SUITE=premium playwright test --project=gitops-mode --no-deps --headed",
    "test:free": "SUITE=free playwright test --project=free; s=$?; SUITE=free PLAYWRIGHT_HTML_OUTPUT_DIR=playwright-report-exclusive playwright test --project=free-exclusive; e=$?; exit $((s || e))",
    "test:free:headed": "SUITE=free playwright test --project=free --headed; s=$?; SUITE=free PLAYWRIGHT_HTML_OUTPUT_DIR=playwright-report-exclusive playwright test --project=free-exclusive --headed; e=$?; exit $((s || e))",
    "test:free:ui": "SUITE=free playwright test --project=free --ui",
    "test:free:exclusive": "SUITE=free playwright test --project=free-exclusive",
    "test:loadtest": "SUITE=loadtest playwright test --project=loadtest",
    "test:loadtest:headed": "SUITE=loadtest playwright test --project=loadtest --headed",
    "test:loadtest:ui": "SUITE=loadtest playwright test --project=loadtest --ui",
    "test:loadtest:api": "SUITE=loadtest playwright test --project=loadtest-api --reporter=list,html",
    "test:gitops-verify:free": "SUITE=free GITOPS_TARGET=../gitops/free-fleetqa playwright test --project=gitops-verify",
    "test:gitops-verify:free-min": "SUITE=free GITOPS_TARGET=../gitops/free-fleetqa-min playwright test --project=gitops-verify",
    "test:gitops-verify:premium": "SUITE=premium GITOPS_TARGET=../gitops/premium-fleetqa playwright test --project=gitops-verify",
    "test:gitops-verify:premium-workstations": "SUITE=premium GITOPS_TARGET=../gitops/premium-fleetqa/fleets/workstations.yml playwright test --project=gitops-verify",
    "test:gitops-verify:premium-qa": "SUITE=premium GITOPS_TARGET=../gitops/premium-fleetqa/fleets/qa.yml playwright test --project=gitops-verify",
    "test:gitops-verify:premium-vms": "SUITE=premium GITOPS_TARGET=../gitops/premium-fleetqa/fleets/vms.yml playwright test --project=gitops-verify",
    "test:gitops-verify:premium-min": "SUITE=premium GITOPS_TARGET=../gitops/premium-fleetqa-min playwright test --project=gitops-verify",
    "test:gitops-verify:premium-min-workstations": "SUITE=premium GITOPS_TARGET=../gitops/premium-fleetqa-min/fleets/workstations.yml playwright test --project=gitops-verify",
    "test:gitops-nightly:premium": "SUITE=premium playwright test --project=gitops-nightly",
    "test:gitops-nightly:free": "SUITE=free playwright test --project=gitops-nightly",
    "test:all": "npm run test:premium && npm run test:free",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "eslint": "^9.39.4",
    "eslint-plugin-playwright": "^2.10.1",
    "js-yaml": "^4.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2"
  },
  "dependencies": {
    "dotenv": "^17.3.1"
  }
}
