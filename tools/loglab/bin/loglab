def load_lab_env():
    """KEY=VALUE from $QALAB_ENV, <tools>/qalab/lab.env, or ~/.config/qalab/lab.env (first that exists)."""
    cands = [os.environ.get("QALAB_ENV"), os.path.join(TOOLS, "qalab", "lab.env"), os.path.expanduser("~/.config/qalab/lab.env")]
    path = next((p for p in cands if p and os.path.isfile(os.path.expanduser(p))), None)
    if not path:
        if sys.argv[1:2] in (["help"], ["-h"], ["--help"]):
            print(__doc__.strip())
            sys.exit(0)
        print("loglab: no lab config. Copy tools/qalab/lab.env.example to tools/qalab/lab.env (or ~/.config/qalab/lab.env, "
              "or point QALAB_ENV at it) and fill it in.", file=sys.stderr)
        sys.exit(1)
    env = {}
    for line in open(os.path.expanduser(path)).read().splitlines():
        m = re.match(r"^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*?)\s*$", line)
        if m and not line.lstrip().startswith("#"):
            v = m.group(2)
            if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
                v = v[1:-1]
            env[m.group(1)] = os.path.expanduser(v) if v.startswith("~") else v
    env["_PATH"] = path
    return env


