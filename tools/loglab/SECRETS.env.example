# loglab secrets for the real-cloud destinations. loglab copies this to $LOGLAB_DATA/SECRETS.env (chmod 600) on
# first run; fill in that copy, never this file. KEY=value, no quotes.

# AWS (kinesis-aws, firehose-aws, lambda-aws). Leave the keys empty to let Fleet use its default AWS credential chain.
AWS_REGION=
# SSO: the profile from `aws configure sso`. loglab and Fleet (env AWS_PROFILE on fleet serve) both read it; keys stay empty.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STS_ASSUME_ROLE_ARN=
AWS_STS_EXTERNAL_ID=
# Cost safeguards (loglab aws guard install): budget + anomaly emails go here. Only used by whoever installs the
# account's guard first; it is shared by everyone after that.
AWS_ALERT_EMAIL=
# Resource names. Empty = fleetqa-<LOGLAB_OWNER>- (and bucket fleetqa-loglab-<owner>-<account>-<region>), which keeps
# several people in one account apart. Anything you set must still start with fleetqa- (bucket: fleetqa-loglab-),
# or the account's guard can't delete it.
KINESIS_STREAM_PREFIX=
FIREHOSE_STREAM_PREFIX=
FIREHOSE_S3_BUCKET=
LAMBDA_FUNCTION_PREFIX=

# Splunk HEC (splunk-cloud), e.g. https://prd-p-xxxx.splunkcloud.com:8088
SPLUNK_URL=
SPLUNK_TOKEN=
SPLUNK_INDEX=
SPLUNK_SOURCE=fleet
SPLUNK_SOURCE_TYPE=fleet:json
SPLUNK_INSECURE_SKIP_VERIFY=false
