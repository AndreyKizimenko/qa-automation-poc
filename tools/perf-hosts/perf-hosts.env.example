# Credentials for the two QA instances the load fleet enrolls into.
#
# Copy to perf-hosts.env (gitignored) and fill in. install.sh sources this and
# substitutes the values into the launchd plists at install time, so the
# committed plists stay free of real credentials.
#
# The enroll secret is at Settings -> Organization settings -> Agent options
# on each instance (or, on free, whatever gitops applied as FLEET_ENROLL_SECRET).
#
# You can also just export these four vars instead of creating the file.

PREMIUM_FLEET_URL=
PREMIUM_ENROLL_SECRET=

FREE_FLEET_URL=
FREE_ENROLL_SECRET=
