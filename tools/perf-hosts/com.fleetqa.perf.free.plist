<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  This is a TEMPLATE. The __FREE_*__ placeholders are substituted by install.sh
  from perf-hosts.env (gitignored) at install time — do not paste the real URL
  or enroll secret in here, this file is committed to a public repo. Install
  via install.sh rather than copying it by hand.

  Persistent osquery-perf load fleet for the FREE QA instance.
  KeepAlive keeps ~300 simulated hosts online 24/7 and relaunches on crash/reboot.
  Install to /Library/LaunchDaemons/ (see install.sh / README.md).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fleetqa.perf.free</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/fleet-perf</string>
        <string>--server_url</string>
        <string>__FREE_FLEET_URL__</string>
        <string>--enroll_secret</string>
        <string>__FREE_ENROLL_SECRET__</string>
        <string>--host_count</string>
        <string>300</string>
        <string>--os_templates</string>
        <string>macos_14.1.2:100,windows_11:100,ubuntu_22.04:100</string>
        <string>--start_period</string>
        <string>2m</string>
        <string>--query_interval</string>
        <string>10s</string>
        <string>--config_interval</string>
        <string>1m</string>
        <!-- Default is 0.2 (20% of live queries return no rows). 0 makes results
             deterministic so tests can assert an actual result row, not just
             "responded". -->
        <string>--live_query_no_results_prob</string>
        <string>0</string>
        <!-- Default is 0.1: ~10% of agents request a host identity certificate at
             startup. That endpoint (/api/fleet/orbit/host_identity/scep) is served
             only from Fleet's ee/ tree, so on FREE it 404s — and osquery-perf
             treats the failure as fatal for that agent (returns out of runLoop, no
             retry). Left at the default, free settles at ~270 hosts instead of 300.
             Premium serves the endpoint, so its plist keeps the default. -->
        <string>--http_message_signature_prob</string>
        <string>0</string>
        <!-- MDM enrollment. mdm_prob applies to macOS and Windows only (Ubuntu is
             unaffected), so 0.3 over the 200 macOS+Windows sims yields ~60
             MDM-enrolled hosts — enough headroom that a spec batch-deleting hosts
             can't strand the suite with zero. The challenge is the server's static
             SCEP shared secret, substituted by install.sh from perf-hosts.env.
             Apple MDM enrollment itself is not premium-gated, so this works on
             free — but READING the challenge on free is harder, because the
             endpoint that exposes it is premium-only. See README, "Getting the
             SCEP challenge". -->
        <string>--mdm_prob</string>
        <string>0.3</string>
        <string>--mdm_scep_challenge</string>
        <string>__FREE_MDM_SCEP_CHALLENGE__</string>
    </array>

    <!-- Keep the simulator running: relaunch on crash and at boot. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Back off before relaunching so a bad config can't hot-loop. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>ProcessType</key>
    <string>Background</string>

    <!-- 300 simulated hosts open far more than macOS's default 256-fd limit;
         launchd doesn't inherit shell ulimits, so raise it here. -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>10240</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>10240</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/usr/local/var/log/fleet-perf-free.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/var/log/fleet-perf-free.log</string>
</dict>
</plist>
