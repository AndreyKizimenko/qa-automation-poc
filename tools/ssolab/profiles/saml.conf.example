# SimpleSAMLphp — copy to $SSOLAB_DATA/profiles/saml.conf, or let `ssolab saml up` write it for you.
# Non-secret: IdP app identifiers only. Keys: <instance>.<sso|eua>.entity_id / .metadata_url / .metadata_file
# (file in $SSOLAB_DATA/metadata/). Instance names come from INSTANCES in lab.env (rc/prev here).
idp_name = SimpleSAMLphp
jit = no
prev.eua.entity_id = urn:fleetqa:prev:mdm
prev.eua.metadata_url = http://localhost:18180/simplesaml/saml2/idp/metadata.php
prev.sso.entity_id = urn:fleetqa:prev:admin
prev.sso.metadata_url = http://localhost:18180/simplesaml/saml2/idp/metadata.php
rc.eua.entity_id = urn:fleetqa:rc:mdm
rc.eua.metadata_url = http://localhost:18180/simplesaml/saml2/idp/metadata.php
rc.sso.entity_id = urn:fleetqa:rc:admin
rc.sso.metadata_url = http://localhost:18180/simplesaml/saml2/idp/metadata.php
