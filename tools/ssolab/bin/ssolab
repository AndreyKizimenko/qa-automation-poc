#!/usr/bin/env -S python3 -I
"""ssolab — switch the identity provider (IdP) each Fleet lab instance uses. See ../README.md.

<inst> is one of INSTANCES from lab.env (e.g. rc, prev).

  ssolab                                  interactive view: instances, active IdP, providers; Enter → switch
  ssolab status [--json]                  instances (up, version, license, admin SSO, end-user auth) + providers
  ssolab doctor                           check lab.env, python, docker, fleetctl contexts, data dir, LOGINS.md
  ssolab switch <inst> <provider|off> [--only sso|eua] [--jit|--no-jit] [--gitops|--no-gitops] [--yes]
                                          point admin SSO + MDM end-user auth at that provider's IdP apps, then verify
  ssolab test <inst>                      re-run the checks: metadata reachable, Fleet → IdP redirect accepted
  ssolab why [inst] [N]                   explain the last N (5) SSO sign-ins from the server log (INSTANCE_<i>_SERVER_LOG):
                                          who got in, and for failures the likely cause + fix
  ssolab setup <provider>                 walkthrough: what to enter in the IdP console, collect metadata → profiles/
  ssolab sp [inst]                        the service-provider values (ACS URLs, entity IDs) to paste into an IdP
  ssolab creds [provider]                 list saved logins (passwords hidden)
  ssolab creds add <provider> [label]     save a login to LOGINS.md (and 1Password, if SSOLAB_OP_VAULT is set)
  ssolab creds show <provider> <label>    print one login, password included
  ssolab creds sync                       push logins that aren't in 1Password yet
  ssolab user create --provider P --username U [--label L] [--email E] [--role R] [--team NAME]
                     [--fleet inst,inst] [--mfa|--no-mfa] [--notes N] --password-stdin|--generate
                                          one IdP test user end to end: IdP + LOGINS/1Password + Fleet (the view's New user form)
  ssolab users [provider]                 SSO test users and whether each exists in Fleet on each instance
  ssolab users sync <provider> [inst|both] [--label L] [--role R] [--team NAME] [--yes]
                                          create the missing ones in Fleet (SSO-only, no password)
  ssolab saml up|down|status|sync         local SimpleSAMLphp IdP on :18180 (knows every instance);
                                          sync = write LOGINS.md saml users into its user list (live)
  ssolab okta connect|provision|user <email> [--mfa|--no-mfa]|mfa [<email> on|off]|status
                                          Okta via its API (org URL + API token): creates the SAML apps, assigns
                                          them to Everyone, creates test users (`ssolab setup okta --manual` = by hand)
  ssolab entra connect|provision|user <name>|mfa [on|off]|status
                                          Entra via Microsoft Graph (tenant + app registration): creates the SAML apps
                                          (open to every tenant user), creates users; mfa = tenant security defaults
  ssolab auth0 connect|provision|user <email>|status
                                          Auth0 via its Management API (domain + M2M client): creates the SAML apps,
                                          enables them on the database connection, creates test users
  ssolab authentik up|down|status|provision|user <email>
                                          self-hosted authentik on :18100; provision creates the SAML apps
  ssolab gitops show|write <inst>|clear
                                          optional: mirror an instance's live IdP settings into SSOLAB_GITOPS_DEFAULT
  Providers: okta auth0 entra google authentik saml

Config: lab.env ($QALAB_ENV, tools/qalab/lab.env, ~/.config/qalab/lab.env). Per-user data: $SSOLAB_DATA.
Only talks to Fleet through the API; only runs its own ssolab-* compose projects (memory-capped, ports 18180/18100).
"""
import datetime
import getpass
import json
import os
import re
import secrets
import shutil
import socket
import ssl
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
LAB_EXAMPLE = os.path.join(os.path.dirname(ROOT), "qalab", "lab.env.example")


def load_lab_env():
    """-> (values, path, error). $QALAB_ENV, then tools/qalab/lab.env, then ~/.config/qalab/lab.env."""
    if os.environ.get("QALAB_ENV"):
        cands = [os.path.expanduser(os.environ["QALAB_ENV"])]
    else:
        cands = [os.path.join(os.path.dirname(ROOT), "qalab", "lab.env"), os.path.expanduser("~/.config/qalab/lab.env")]
    path = next((c for c in cands if os.path.isfile(c)), None)
    if not path:
        return {}, None, (f"no lab config: looked for {' and '.join(cands)}. Copy {LAB_EXAMPLE} "
                          "to one of those (or point QALAB_ENV at it) and fill it in.")
    d = {}
    for line in open(path):
        line = line.strip()
        if line.startswith("export "):
            line = line[7:].strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        v = v.strip()
        if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
            v = v[1:-1]
        d[k.strip()] = os.path.expanduser(v) if v.startswith("~") else v
    return d, path, ""


LAB, LAB_PATH, LAB_ERR = load_lab_env()
DATA = LAB.get("SSOLAB_DATA", "")
PROFILES = os.path.join(DATA, "profiles")
METADATA = os.path.join(DATA, "metadata")
STATE = os.path.join(DATA, "state")
LOGINS = os.path.join(DATA, "LOGINS.md")
HISTORY = os.path.join(STATE, "history.log")
GITOPS_DEFAULT = LAB.get("SSOLAB_GITOPS_DEFAULT", "")   # empty = gitops commands off
FLEET_CONFIG = os.path.expanduser("~/.fleet/config")
VAULT = LAB.get("SSOLAB_OP_VAULT", "")                  # empty = no 1Password sync

# name -> fallback public URL (the live server_url wins; ACS URLs are built from it)
INSTANCES = {i: LAB.get(f"INSTANCE_{i}_URL", "") for i in LAB.get("INSTANCES", "").split()}


def inst_opt(inst, key, default=""):
    return LAB.get(f"INSTANCE_{inst}_{key}") or default


def inst_context(inst):
    return inst_opt(inst, "CONTEXT", inst)


def inst_fleetctl(inst):
    return inst_opt(inst, "FLEETCTL") or shutil.which("fleetctl") or ""


def first_inst():
    return next(iter(INSTANCES), "")


def require_lab():
    if LAB_ERR:
        die(LAB_ERR)
    if not INSTANCES:
        die(f"INSTANCES is empty in {LAB_PATH} (see {LAB_EXAMPLE})")
    if not DATA:
        die(f"SSOLAB_DATA isn't set in {LAB_PATH}: point it at a folder for your logins and profiles (see {LAB_EXAMPLE})")


def need(cmd, hint=""):
    if not shutil.which(cmd):
        die(f"{cmd} not found on PATH{' — ' + hint if hint else ''}")


def saved_to():
    return "LOGINS.md + 1Password" if VAULT else "LOGINS.md"


FEATURES = {
