# qalab lab config: one file shared by vm, ssolab, loglab and qalab.
#
# Copy to tools/qalab/lab.env (gitignored), or anywhere and point QALAB_ENV at it.
# Lookup order: $QALAB_ENV, tools/qalab/lab.env, ~/.config/qalab/lab.env.
#
# Plain KEY=VALUE lines (no `export`, no command substitution). A leading ~ is
# expanded. Secrets do NOT go here: each tool keeps them in its own data dir
# (vm: $VM_DATA/LOGINS.md, ssolab: $SSOLAB_DATA/LOGINS.md, loglab: $LOGLAB_DATA/SECRETS.env).

# --- Fleet instances ---------------------------------------------------------
# Space-separated names. Each tool accepts these as the <instance> argument.
INSTANCES="rc prev"

# Per instance (replace rc/prev with your names):
#   _CONTEXT     fleetctl context in ~/.fleet/config (needs an API token)
#   _URL         public server URL (fallback; the live server_url wins)
#   _FLEETCTL    fleetctl binary for this instance (default: fleetctl on PATH)
#   _SRC         optional fleet source checkout the server runs from
#   _FLEET_BIN   optional built `fleet` binary (loglab validates configs with it)
#   _SERVER_LOG  optional server log file (ssolab why, loglab stdout/test/view)
#   _HANGAR_ID   optional Fleet Hangar server id (s1, s2...), if you use Hangar
INSTANCE_rc_CONTEXT=rc
INSTANCE_rc_URL=https://fleet-rc.example.com
INSTANCE_rc_FLEETCTL=
INSTANCE_rc_SRC=
INSTANCE_rc_FLEET_BIN=
INSTANCE_rc_SERVER_LOG=
INSTANCE_rc_HANGAR_ID=

INSTANCE_prev_CONTEXT=prev
INSTANCE_prev_URL=https://fleet-prev.example.com
INSTANCE_prev_FLEETCTL=
INSTANCE_prev_SRC=
INSTANCE_prev_FLEET_BIN=
INSTANCE_prev_SERVER_LOG=
INSTANCE_prev_HANGAR_ID=

# --- vm -----------------------------------------------------------------------
# Where your UTM bundles (golden/, hosts/), inventory.tsv and LOGINS.md live.
VM_DATA=~/qalab/vm
# fleetd packages, one subfolder per instance: $INSTALLERS_DIR/<instance>/*.deb|rpm|pkg|msi
INSTALLERS_DIR=~/qalab/installers
# SSH key whose .pub is in the guests' authorized_keys
SSH_KEY=~/.ssh/qalab_ed25519
GUEST_USER=qa
UTMCTL=/Applications/UTM.app/Contents/MacOS/utmctl

# --- ssolab -------------------------------------------------------------------
SSOLAB_DATA=~/qalab/ssolab
# Optional: GitOps default.yml that `ssolab gitops` edits. Empty = gitops commands off.
SSOLAB_GITOPS_DEFAULT=
# Optional: 1Password vault for `ssolab` logins sync (needs the op CLI)
SSOLAB_OP_VAULT=

# --- loglab -------------------------------------------------------------------
LOGLAB_DATA=~/qalab/loglab
# Tagged on every AWS resource loglab creates (and in default names); `aws down` only deletes your own.
# The account's shared guard still deletes anyone's resources once they expire. Default: $USER
LOGLAB_OWNER=
# Splunk Enterprise's container requires accepting its license
# (https://www.splunk.com/en_us/legal/splunk-general-terms.html). Set to 1 if you accept.
LOGLAB_ACCEPT_SPLUNK_LICENSE=0

# --- Fleet Hangar (optional) --------------------------------------------------
# If you run your servers from Fleet Hangar, its app-support/log dirs are detected
# automatically; set HANGAR=0 to ignore Hangar even if it's installed.
HANGAR=auto
